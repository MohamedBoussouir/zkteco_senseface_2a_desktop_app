<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Daily attendance list view-->
    <record id="daily_attendance_view_list" model="ir.ui.view">
        <field name="name">daily.attendance.view.list</field>
        <field name="model">daily.attendance</field>
        <field name="arch" type="xml">
            <list string="Attendance" create="false" delete="true" decoration-danger="not is_danger">
                <field name="device_id_num" string="Device ID"/>
                <field name="employee_id"/>
                <field name="i_check" string="Check In Type"/>
                <field name="check_in"/>
                <field name="o_check" string="Type"/>
                <field name="check_out"/>

                <field name="is_danger" invisible="1" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="daily_attendance_search_view" model="ir.ui.view">
        <field name="name">daily.attendance.search.view</field>
        <field name="model">daily.attendance</field>
        <field name="arch" type="xml">
            <search>
                <field name="device_id_num"/>
                <field name="employee_id"/>
                <field name="check_in"/>
                <field name="i_check"/>
                <field name="check_out"/>
                <field name="o_check"/>
                
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Month" name="month" context="{'group_by': 'check_in:month'}"/>
                    <filter string="Day" name="day" context="{'group_by': 'check_in:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!--    Attendance analysis action-->
    <record id="daily_attendance_action" model="ir.actions.act_window">
        <field name="name">Attendance Analysis</field>
        <field name="res_model">daily.attendance</field>
        <field name="view_mode">list</field>
        <field name="context">{}</field>
    </record>
</odoo>
