<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Device User List View -->
    <record id="view_biometric_device_user_list" model="ir.ui.view">
        <field name="name">biometric.device.user.list</field>
        <field name="model">biometric.device.user</field>
        <field name="arch" type="xml">
            <list string="Device Users">
                <field name="device_id"/>
                <field name="name"/>
                <field name="privilege"/>
                <field name="device_details_id"/>
                <button name="action_enroll_fingerprint" string="Enroll Fingerprint" type="object" icon="fa-hand-pointer-o" class="btn-info"/>
                <button name="action_push_to_device" string="Push to Device" type="object" icon="fa-upload" class="btn-primary"/>
                <button name="action_delete_from_device" string="Delete from Device" type="object" icon="fa-trash" class="btn-danger" confirm="Are you sure you want to delete this user from the physical device?"/>
            </list>
        </field>
    </record>

    <!-- Device User Form View -->
    <record id="view_biometric_device_user_form" model="ir.ui.view">
        <field name="name">biometric.device.user.form</field>
        <field name="model">biometric.device.user</field>
        <field name="arch" type="xml">
            <form string="Device User">
                <header>
                    <button name="action_enroll_fingerprint" string="Enroll Fingerprint" type="object" class="btn-info" icon="fa-hand-pointer-o"/>
                    <button name="action_delete_fingerprint" string="Delete Selected Finger" type="object" class="btn-warning" icon="fa-eraser" confirm="Are you sure you want to delete this specific finger template from the device?"/>
                    <button name="action_fetch_remote_fingerprints" string="Fetch Fingers" type="object" class="btn-success" icon="fa-refresh"/>
                    <button name="action_test_beep" string="Test Beep" type="object" class="btn-secondary" icon="fa-volume-up"/>
                    <button name="action_push_to_device" string="Push to Device" type="object" class="oe_highlight" icon="fa-upload"/>
                    <button name="action_delete_from_device" string="Delete from Device" type="object" class="btn-danger" icon="fa-trash" confirm="Are you sure you want to delete this user from the physical device?"/>
                </header>
                <sheet>
                    <group>
                        <group string="Basic Information">
                            <field name="employee_id" options="{'no_create': True}"/>
                            <field name="name"/>
                            <field name="device_id"/>
                            <field name="user_id_num"/>
                            <field name="registered_fingers"/>
                        </group>
                        <group string="Device Settings">
                            <field name="device_details_id"/>
                            <field name="privilege"/>
                            <field name="password" password="True"/>
                            <field name="group_id"/>
                            <field name="fingers_status_html" nolabel="1" colspan="2"/>
                            <field name="finger_index" widget="radio" options="{'horizontal': true}"/>
                        </group>
                    </group>
                    <div class="o_horizontal_separator">Finger Mapping Reference</div>
                    <div style="text-align: center;">
                        <img src="/hs_zk_attendance/static/src/img/fingers_map.png" style="max-width: 100%; height: auto; border: 1px solid #ccc; border-radius: 8px; padding: 10px;"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Device Users -->
    <record id="action_biometric_device_user" model="ir.actions.act_window">
        <field name="name">Device Users</field>
        <field name="res_model">biometric.device.user</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage users on your biometric device.
            </p>
        </field>
    </record>
</odoo>
