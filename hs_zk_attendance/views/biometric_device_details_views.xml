<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Biometric device configuration list view-->
    <record id="biometric_device_details_view_list" model="ir.ui.view">
        <field name="name">biometric.device.details.view.list</field>
        <field name="model">biometric.device.details</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="device_ip"/>
                <field name="port_number"/>
            </list>
        </field>
    </record>
    <!--Biometric device configuration list view-->
    <record id="biometric_device_details_view_form" model="ir.ui.view">
        <field name="name">biometric.device.details.view.form</field>
        <field name="model">biometric.device.details</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_download_attendance"
                            string="Download Data"
                            icon="fa-download "
                            type="object" class="oe_highlight"/>
                    <button name="action_fetch_users" string="Fetch Users" type="object" icon="fa-users" class="oe_highlight"/>
                    <button name="action_sync_all_fingerprints" string="Sync All Fingerprints" type="object" icon="fa-refresh" class="btn-success"/>
                    <button name="action_restart_device" string="Restart"
                            type="object" class="oe_highlight"
                            icon="fa-refresh"
                            confirm="Are you sure you want Restart the Biometric
                            Device?"/>
                    <button name="action_test_live_capture" 
                            string="Test Live Support" 
                            type="object" 
                            class="btn-info" 
                            icon="fa-bolt"/>
                    <button name="action_clear_attendance_log"
                            string="Clear Logs"
                            type="object"
                            class="btn-danger"
                            icon="fa-trash"
                            confirm="Are you sure you want to delete all attendance logs from the device? This action cannot be undone!"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="device_ip"/>
                        </group>
                        <group>
                            <field name="port_number"/>
                            <field name="port_number2"/>
                            <field name="port_number3"/>
                            <field name="comm_key"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attendance Logs Sync" name="attendance_logs">
                            <group>
                                <label for="date_to" string="Date Range to Sync"/>
                                <div class="o_row">
                                    <field name="date_to" class="oe_inline" widget="daterange" options="{'related_end_date': 'date_from'}"/>
                                    <field name="date_from" class="oe_inline" widget="daterange" options="{'related_start_date': 'date_to'}"/>
                                    <button name="action_set_dates_to_today" type="object" string="Today" class="btn-link" icon="fa-calendar-check-o" title="Set both dates to Today"/>
                                </div>
                            </group>
                            <button name="action_download_attendance"
                                    type="object" class="btn btn-secondary">
                                <i class="fa fa-fw o_button_icon fa-download"/>
                                Sync Logs Now
                            </button>
                            <button name="action_clear_attendance_log"
                                    type="object" class="btn btn-outline-danger ms-2"
                                    confirm="Are you sure you want to delete all attendance logs from the device?">
                                <i class="fa fa-fw o_button_icon fa-trash"/>
                                Clear Device Logs
                            </button>
                        </page>
                        <page string="Device Settings" name="device_settings">
                            <group string="Sound Management (Voice Prompts)">
                                <group>
                                    <field name="mute_sounds" widget="boolean_toggle"/>
                                </group>
                                <group invisible="mute_sounds == True">
                                    <group string="Enrollment (User Page)">
                                        <label for="enrollment_voice_index" string="Sound ID"/>
                                        <div class="o_row">
                                            <field name="enrollment_voice_index" class="oe_inline"/>
                                            <button name="action_play_sound_by_index" type="object" icon="fa-play" class="btn-sm btn-link" context="{'sound_idx': enrollment_voice_index}" title="Test Sound"/>
                                            <field name="mute_enrollment" widget="boolean_toggle" title="Mute this button only"/>
                                        </div>
                                    </group>
                                    <group string="Download Data">
                                        <label for="download_sound_index" string="Sound ID"/>
                                        <div class="o_row">
                                            <field name="download_sound_index" class="oe_inline"/>
                                            <button name="action_play_sound_by_index" type="object" icon="fa-play" class="btn-sm btn-link" context="{'sound_idx': download_sound_index}" title="Test Sound"/>
                                            <field name="mute_download" widget="boolean_toggle"/>
                                        </div>
                                    </group>
                                    <group string="Fetch Users">
                                        <label for="fetch_users_sound_index" string="Sound ID"/>
                                        <div class="o_row">
                                            <field name="fetch_users_sound_index" class="oe_inline"/>
                                            <button name="action_play_sound_by_index" type="object" icon="fa-play" class="btn-sm btn-link" context="{'sound_idx': fetch_users_sound_index}" title="Test Sound"/>
                                            <field name="mute_fetch_users" widget="boolean_toggle"/>
                                        </div>
                                    </group>
                                    <group string="Restart Device">
                                        <label for="restart_sound_index" string="Sound ID"/>
                                        <div class="o_row">
                                            <field name="restart_sound_index" class="oe_inline"/>
                                            <button name="action_play_sound_by_index" type="object" icon="fa-play" class="btn-sm btn-link" context="{'sound_idx': restart_sound_index}" title="Test Sound"/>
                                            <field name="mute_restart" widget="boolean_toggle"/>
                                        </div>
                                    </group>
                                    <group string="Test Connection (Beep)">
                                        <label for="test_beep_sound_index" string="Sound ID"/>
                                        <div class="o_row">
                                            <field name="test_beep_sound_index" class="oe_inline"/>
                                            <button name="action_play_sound_by_index" type="object" icon="fa-play" class="btn-sm btn-link" context="{'sound_idx': test_beep_sound_index}" title="Test Sound"/>
                                            <field name="mute_test_beep" widget="boolean_toggle"/>
                                        </div>
                                    </group>
                                    <group string="Push to Device">
                                        <label for="push_user_sound_index" string="Sound ID"/>
                                        <div class="o_row">
                                            <field name="push_user_sound_index" class="oe_inline"/>
                                            <button name="action_play_sound_by_index" type="object" icon="fa-play" class="btn-sm btn-link" context="{'sound_idx': push_user_sound_index}" title="Test Sound"/>
                                            <field name="mute_push_user" widget="boolean_toggle"/>
                                        </div>
                                    </group>
                                    <group string="Delete from Device">
                                        <label for="delete_user_sound_index" string="Sound ID"/>
                                        <div class="o_row">
                                            <field name="delete_user_sound_index" class="oe_inline"/>
                                            <button name="action_play_sound_by_index" type="object" icon="fa-play" class="btn-sm btn-link" context="{'sound_idx': delete_user_sound_index}" title="Test Sound"/>
                                            <field name="mute_delete_user" widget="boolean_toggle"/>
                                        </div>
                                    </group>
                                </group>
                            </group>
                        </page>
                        <page string="Attendance Settings">
                            <group>
                                <group string="Daily Shift Times">
                                    <field name="shift_start" widget="float_time"/>
                                    <field name="shift_end" widget="float_time"/>
                                </group>
                                <group string="Advanced Logic">
                                    <field name="max_shift_hours" widget="float_time"/>
                                    <field name="resource_calendar_id" readonly="1" force_save="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    
                    <button name="action_test_connection"
                            type="object" class="btn btn-primary" style="margin-top: 10px;">
                        <i class="fa fa-fw o_button_icon fa-television"/>
                        Test Connection
                    </button>
                </sheet>
            </form>
        </field>
    </record>
    <!--	Action for the biometric device-->
    <record id="biometric_device_details_action" model="ir.actions.act_window">
        <field name="name">Biometric Device</field>
        <field name="res_model">biometric.device.details</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>
